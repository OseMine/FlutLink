{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlutLink",
  "version": "1.3.0",
  "identifier": "de.flut.flutlink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlutLink",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "cli": {
      "description": "FlutLink — FlutCloud desktop client",
      "args": [
        {
          "name": "sync",
          "short": "s",
          "description": "Run a sync pass after startup",
          "takesValue": false,
          "multiple": false
        },
        {
          "name": "path",
          "short": "p",
          "description": "Add a local folder to the two-way sync",
          "takesValue": true,
          "multiple": false
        },
        {
          "name": "url",
          "short": "u",
          "description": "Open the login dialog for the FlutCloud server",
          "takesValue": true,
          "multiple": false
        },
{
            "name": "tray",
            "short": "t",
            "description": "Start minimized to the system tray",
            "takesValue": false,
            "multiple": false
          },
          {
            "name": "download",
            "description": "Headless download of a remote file: flutlink --download <remote_path> --download-to <local_path>",
            "takesValue": true,
            "multiple": false
          },
          {
            "name": "download-to",
            "description": "Local target path for --download",
            "takesValue": true,
            "multiple": false
          },
          {
            "name": "list",
            "description": "Headless listing of a cloud folder: flutlink --list <remote_path> (prints JSON to stdout)",
            "takesValue": true,
            "multiple": false
          }
        ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3NUU2NUJCODFBODdGRkIKUldUN2Y2aUJ1MlZleC95Z3B4dGg1SGt0ckdJVEowYVR6Q3VqVytUbThhK3VYbE42UzhMN0ltK28K",
      "endpoints": [
        "https://github.com/OseMine/FlutLink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
