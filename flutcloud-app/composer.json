{
    "name": "flut/flutcloud",
    "description": "FlutCloud — Nextcloud app providing the non-standard server features used by the FlutLink client",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": ["nextcloud", "flutcloud", "flutlink"],
    "autoload": {
        "psr-4": {
            "OCA\\FlutCloud\\": "lib/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "check": [
            "@php -l lib/AppInfo/Application.php",
            "@php -l lib/Capabilities.php",
            "@php -l lib/Controller/IosController.php",
            "@php -l lib/Controller/LinksController.php",
            "@php -l lib/Controller/OcsControllerBase.php",
            "@php -l lib/Controller/PartsController.php",
            "@php -l lib/Controller/PingController.php",
            "@php -l lib/Controller/ProjectFolderController.php",
            "@php -l lib/Exception/InvalidNameException.php",
            "@php -l lib/Exception/NotAFolderException.php",
            "@php -l lib/Service/AltStoreSourceService.php",
            "@php -l lib/Service/LinkService.php",
            "@php -l lib/Service/NameValidator.php",
            "@php -l appinfo/routes.php"
        ]
    }
}
